    "jest": "^29.3.1",
    "jsonwebtoken": "^9.0.0",
    "mysql2": "^3.2.3",
    "nodemailer": "^9.0.1",
    "parse": "^4.0.1",
    "sequelize": "^6.19.0",
    "supertest": "^6.3.3"
